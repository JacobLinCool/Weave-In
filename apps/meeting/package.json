{
  "name": "@weave-in/meeting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=./wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=./wrangler.log vite build && node scripts/verify-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "WRANGLER_LOG_PATH=./wrangler.log vitest run",
    "deploy": "pnpm build && WRANGLER_LOG_PATH=./wrangler.log wrangler deploy",
    "deploy:dry-run": "pnpm build && WRANGLER_LOG_PATH=./wrangler.log wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "5.2.8",
    "@fontsource-variable/jost": "5.2.8",
    "@weave-in/transcribe": "workspace:*",
    "lucide-react": "1.34.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/vitest-plugin": "1.1.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  }
}
