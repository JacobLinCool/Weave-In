{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weave-in-meeting",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MeetingRoom"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "418273",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "418274",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MeetingRoom"]
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  }
}
